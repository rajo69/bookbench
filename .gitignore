# Local secrets (never committed)
.env
.env.*

# Note: the dataset files under evals/datasets/ (including *.jsonl and manifest.json) are tracked on purpose.

# hf/ is generated by scripts/export_hf.py and published to Hugging Face; only its two inputs are tracked here.
hf/*
!hf/card_header.yaml
!hf/CARD_BODY.md
